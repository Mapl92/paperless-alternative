DATABASE_URL="postgresql://documind:documind_secret@db:5432/documind"

# Auth
AUTH_SECRET="change-me-to-a-random-secret-in-production"
AUTH_PASSWORD="admin"

# API token for trusted external clients (e.g. NotchConverter Mac app).
# Send as `Authorization: Bearer <token>` on /api routes. Leave empty to disable.
# Generate: openssl rand -hex 32
API_TOKEN=""

# AI / OpenRouter (for OCR, classification, chat)
OPENROUTER_API_KEY="sk-or-v1-your-key-here"
OPENROUTER_MODEL="openai/gpt-5.6-luna"
OPENROUTER_CHAT_MODEL="openai/gpt-5.6-luna"
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"

# Google Gemini (for embeddings / semantic search)
GEMINI_API_KEY="your-gemini-api-key-here"
# Conservative pacing for free-tier embedding reindex batches (milliseconds)
EMBEDDING_BACKFILL_DELAY_MS="4000"

# File Storage
DATA_DIR="/app/data"
CONSUME_DIR="/app/data/consume"

# Cloudflare R2 (optional — for document sharing via external links)
# R2_ACCOUNT_ID="your-cloudflare-account-id"
# R2_ACCESS_KEY_ID="your-r2-access-key-id"
# R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
# R2_BUCKET_NAME="documind-shares"

# App
NEXT_PUBLIC_APP_NAME="DocuMind"
